<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/styleSingleProduct.css" />
  <link rel="shortcut icon" href="/img/Logo_Byte.png" type="image/x-icon" />
  <title><%= name %> — ByteZone</title>
</head>
<%- include('./partials/tracker') %>
<body>
  <nav class="navbar">
    <a href="/store"><img src="/img/nav_left.svg" alt="back"> Store</a>
  </nav>

  <main class="item-card">
    <div class="img">
      <img loading="lazy" src="/img/image/<%= image %>" alt="<%= name %>">
    </div>
    <div class="text-section">
      <h2><%= name %></h2>
      <ul>
        <li><h4>Category:</h4><p><%= category %></p></li>
        <li><h4>Price:</h4><p style="color:#1fe7f1;font-weight:700;font-size:1.1rem;">₹<%= price.toLocaleString('en-IN') %></p></li>
        <li><h4>Stock:</h4><p><%= qty > 0 ? qty + ' available' : 'Out of stock' %></p></li>
      </ul>

      <% if (locals.specification) { %>
      <h4 style="margin-top:0.5rem;">Specifications</h4>
      <table class="spec-table">
        <tr><td>Processor</td><td><%= specification.processor %></td></tr>
        <tr><td>RAM</td><td><%= specification.ram %></td></tr>
        <tr><td>Storage</td><td><%= specification.storage %></td></tr>
        <tr><td>Battery</td><td><%= specification.battery %></td></tr>
        <tr><td>Graphics</td><td><%= specification.graphicCard %></td></tr>
      </table>
      <% } %>

      <% if (locals.description) { %>
      <p style="color:rgba(230,237,243,0.65);font-size:0.9rem;line-height:1.6;"><%= description %></p>
      <% } %>

      <% if (qty > 0) { %>
      <div class="section">
        <div class="buy">
          <a href="/buy?item=<%= id %>&type=<%= type %>">Buy Now</a>
        </div>
        <div class="buy addToCart">
          <a href="/buy/addToCart?item=<%= id %>&type=<%= type %>">Add to Cart</a>
        </div>
      </div>
      <% } else { %>
      <p style="color:#f87171;font-weight:600;">Currently out of stock</p>
      <% } %>
    </div>
  </main>

  <%- include('./partials/scripts') %>
</body>
</html>
