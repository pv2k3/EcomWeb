<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/styleSingleProduct.css" />
  <link rel="shortcut icon" href="/img/Logo_Byte.png" type="image/x-icon" />
  <title>Buy — <%= name %></title>
  <style>
    body { font-family: -apple-system, 'Inter', sans-serif; }
    .order-card {
      background: rgba(57,62,70,0.4);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 1rem;
      padding: 1.5rem;
      margin: 1rem auto;
      width: 90%;
      max-width: 700px;
    }
    .qty-row { display: flex; align-items: center; gap: 1rem; margin: 1rem 0; }
    .qty-row label { color: #eeeeee; font-size: 1.1rem; font-weight: 500; }
    .qty-input {
      width: 80px;
      padding: 0.5rem;
      background: rgba(34,40,49,0.5);
      border: 2px solid #1fe7f1;
      border-radius: 0.5rem;
      color: white;
      font-size: 1.1rem;
      text-align: center;
    }
    .price-display { font-size: 1.5rem; font-weight: 700; color: #1fe7f1; margin: 0.5rem 0; }
    .delivery-card {
      background: rgba(57,62,70,0.25);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 0.75rem;
      padding: 1rem 1.5rem;
      margin: 1rem auto;
      width: 90%;
      max-width: 700px;
    }
    .delivery-card h4 { color: #e7b597; margin-bottom: 0.75rem; font-size: 1.1rem; }
    .delivery-card p { color: rgba(238,238,238,0.8); margin: 0.25rem 0; font-size: 0.95rem; }
    .pay-btn {
      display: block;
      width: 90%;
      max-width: 700px;
      margin: 1.5rem auto;
      padding: 1rem;
      background: #1fe7f1;
      color: #222831;
      border: none;
      border-radius: 2rem;
      font-size: 1.25rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .pay-btn:hover { opacity: 0.85; transform: translateY(-1px); box-shadow: 0 4px 20px rgba(31,231,241,0.35); }
    .stock-note { text-align: center; color: rgba(255,255,255,0.4); font-size: 0.85rem; margin-top: 0.25rem; }
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/store"><img src="/img/nav_left.svg" alt="back"> Store</a>
  </nav>

  <main class="item-card order-card">
    <div class="img">
      <img src="/img/image/<%= image %>" alt="<%= name %>">
    </div>
    <div class="text-section">
      <h2><%= name %></h2>
      <div class="qty-row">
        <label for="quantity">Quantity:</label>
        <input type="number" id="quantity" class="qty-input" min="1" max="<%= qty %>" value="1">
      </div>
      <div class="price-display" id="priceDisplay">₹<%= price.toLocaleString('en-IN') %></div>
      <p class="stock-note"><%= qty %> in stock</p>
    </div>
  </main>

  <div class="delivery-card">
    <h4>Delivery Details</h4>
    <p><strong>Address:</strong> <%= address %></p>
    <p><strong>Contact:</strong> <%= contact %></p>
  </div>

  <button class="pay-btn" id="payBtn">Pay with Razorpay</button>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    const basePrice = <%= price %>;
    const maxQty = <%= qty %>;
    const productId = "<%= id %>";
    const productType = "<%= type %>";
    const razorpayKeyId = "<%= razorpayKeyId %>";

    const qtyInput = document.getElementById("quantity");
    const priceDisplay = document.getElementById("priceDisplay");

    qtyInput.addEventListener("input", () => {
      const q = Math.min(Math.max(1, parseInt(qtyInput.value) || 1), maxQty);
      qtyInput.value = q;
      priceDisplay.textContent = "₹" + (basePrice * q).toLocaleString("en-IN");
    });

    document.getElementById("payBtn").addEventListener("click", async () => {
      const quantity = parseInt(qtyInput.value) || 1;

      const resp = await fetch("/buy/create-order", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ quantity, productId, productType }),
      });

      if (!resp.ok) {
        const err = await resp.json().catch(() => ({}));
        alert(err.error || "Failed to create order. Please try again.");
        return;
      }

      const data = await resp.json();

      const options = {
        key: razorpayKeyId,
        amount: data.amount,
        currency: data.currency,
        name: "ByteZone",
        description: data.productName,
        order_id: data.orderId,
        handler: function (response) {
          // Post verification form
          const form = document.createElement("form");
          form.method = "POST";
          form.action = "/buy/verify";

          const fields = {
            razorpay_order_id: response.razorpay_order_id,
            razorpay_payment_id: response.razorpay_payment_id,
            razorpay_signature: response.razorpay_signature,
            productId,
            productType,
            quantity,
          };

          Object.entries(fields).forEach(([k, v]) => {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = k;
            input.value = v;
            form.appendChild(input);
          });

          document.body.appendChild(form);
          form.submit();
        },
        prefill: {
          contact: "<%= contact %>",
        },
        theme: { color: "#1fe7f1" },
        modal: { ondismiss: function() { console.log("Payment modal closed"); } }
      };

      const rzp = new Razorpay(options);
      rzp.open();
    });
  </script>
</body>
</html>
